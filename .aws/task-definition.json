{
  "family": "ecommerce-webapp",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
      "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::536697239284:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::536697239284:role/ecsTaskRole",
  "containerDefinitions": [
      {
          "name": "backend",
          "image": "projects/pet-accessories-backend:latest",
          "portMappings": [
              {
                  "containerPort": 5000,
                  "protocol": "tcp"
              }
          ],
          "essential": true,
          "environment": [
              {
                  "name": "NODE_ENV",
                  "value": "production"
              },
              {
                  "name": "PORT",
                  "value": "5000"
              }
          ],
          "secrets": [
              {
                  "name": "MONGODB_URI",
                  "valueFrom": "arn:aws:ssm:us-east-1:536697239284:parameter/MONGODB_URI"
              }
          ],
          "logConfiguration": {
              "logDriver": "awslogs",
              "options": {
                  "awslogs-group": "/ecs/ecommerce-webapp",
                  "awslogs-region": "us-east-1",
                  "awslogs-stream-prefix": "backend"
              }
          }
      },
      {
          "name": "frontend",
          "image": "projects/pet-accessories-frontend:latest",
          "portMappings": [
              {
                  "containerPort": 8080,
                  "protocol": "tcp"
              }
          ],
          "essential": true,
          "logConfiguration": {
              "logDriver": "awslogs",
              "options": {
                  "awslogs-group": "/ecs/ecommerce-webapp",
                  "awslogs-region": "us-east-1",
                  "awslogs-stream-prefix": "frontend"
              }
          }
      }
  ]
}
